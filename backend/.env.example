# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_KEY=your_supabase_secret_key

# Optional: chạy migration SQL từ máy (npm run migrate:all)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@....pooler.supabase.com:6543/postgres
# Hoặc Management API:
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=your_project_ref

# JWT Authentication — BẮT BUỘC ≥ 32 ký tự (không có fallback mặc định)
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars!!
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars!
BCRYPT_SALT_ROUNDS=12

# CORS — Frontend URL(s), cách nhau bởi dấu phẩy. Production: KHÔNG dùng *
# Local: http://localhost:5173
# Production (cùng origin API+SPA): https://education-center-api.onrender.com
CORS_ORIGIN=http://localhost:5173

# File Uploads (local disk; ephemeral on Render free)
UPLOAD_DIR=uploads

# Supabase Storage — ngân hàng câu hỏi (tạo bucket trùng tên trong Dashboard → Storage)
QUESTION_BANK_BUCKET=question-bank

# Seed admin production only (npm run seed:admin)
# ADMIN_EMAIL=admin@yourschool.com
# ADMIN_PASSWORD=change-me-strong-password

# ---- Đồng bộ lịch sang Google Sheets (tuỳ chọn) ----
# Thiếu hai biến này thì trang đăng ký vẫn chạy bình thường, chỉ là không ghi
# sang Sheet. Mỗi NĂM một tab, tên tab là năm ("2026").
#
# Cách bật:
#   1. Google Cloud Console > tạo service account > Keys > Add key (JSON)
#   2. Bật Google Sheets API cho project đó
#   3. Mở file Sheet > Chia sẻ > dán client_email trong file JSON, quyền Editor
#   4. Điền hai biến dưới đây
#
# Dán NGUYÊN nội dung file JSON vào một dòng (Render không có hệ thống file cố
# định nên không dùng được đường dẫn file):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Chạy máy ở nhà thì để file rồi trỏ đường dẫn, tương đối so với thư mục backend:
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
#
# Dán ID hay dán cả link đều được, code tự cắt:
# GOOGLE_SHEETS_SPREADSHEET_ID=1AbC...
